# Copy to .env
DATABASE_URL="postgresql://worklog:worklog@localhost:5432/worklog?schema=public"
# Used by integration tests (a separate, disposable database)
DATABASE_URL_TEST="postgresql://worklog:worklog@localhost:5433/worklog_test?schema=public"
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
# How many reverse proxies sit in front of the app and append to X-Forwarded-For.
# 0 = trust nothing (use the direct peer; dev only). See src/server/security/client-ip.ts.
TRUST_PROXY_HOPS=1
# Where check-in photos are stored (local disk driver)
STORAGE_DIR="./storage"
# Hours after which an un-checked-out day is considered a missed check-out
STALE_SHIFT_HOURS=16
# Public URL of the app (used in email links)
APP_URL="http://localhost:3000"
# Email. Unset in development = emails are printed to the server log.
# docker compose includes Mailpit: SMTP_URL="smtp://localhost:1025", inbox at http://localhost:8025
SMTP_URL=""
MAIL_FROM="WorkLog <no-reply@worklog.local>"
# Background sweep (escalations, stale days, email retries) runs in-process every 15 min.
# For serverless hosting set DISABLE_SCHEDULER=1 and POST /api/cron/sweep with this secret.
CRON_SECRET=""
DISABLE_SCHEDULER=""

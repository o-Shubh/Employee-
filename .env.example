# Copy to .env
DATABASE_URL="postgresql://worklog:worklog@localhost:5432/worklog?schema=public"
# Used by integration tests (a separate, disposable database)
DATABASE_URL_TEST="postgresql://worklog:worklog@localhost:5433/worklog_test?schema=public"
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
# How many reverse proxies sit in front of the app and append to X-Forwarded-For.
# 0 = trust nothing (use the direct peer; dev only). See src/server/security/client-ip.ts.
TRUST_PROXY_HOPS=1
# Where check-in photos are stored (local disk driver)
STORAGE_DIR="./storage"
# Hours after which an un-checked-out day is considered a missed check-out
STALE_SHIFT_HOURS=16
